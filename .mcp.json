{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": [
        "--headless",
        "--browser", "chromium",
        "--isolated",
        "--allow-unrestricted-file-access",
        "--viewport-size", "1920x1080",
        "--output-dir", "/tmp/playwright-mcp"
      ],
      "tools": ["*"]
    }
  }
}
